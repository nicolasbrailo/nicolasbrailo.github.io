		$('#header_search_reset_sub').click(function(e){
			
			e.preventDefault();
			
			var $searchInputSub = $('#header_search_input_sub');

			$searchInputSub.val(''); // focus();
			
			setTimeout(function(){
				$searchInputSub.focus();
