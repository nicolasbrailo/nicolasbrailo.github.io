(function($) {

	// ------------------------------------
	// Prefs
	// ------------------------------------
	var maxResults = 4;

	// ------------------------------------
	// Selectors
	// ------------------------------------
	var searchFieldID = 'header_search_input';
	var searchFieldSel = '#' + searchFieldID;
	var searchToggleSel = '#site_search_toggle';
	var searchInputContainer = document.querySelector('#js-header_search_input_container');

	var searchsubFieldID = 'header_search_input_sub';
	var searchsubFieldSel = '#' + searchsubFieldID;
	var searchsubToggleSel = '#js-header_search_input_sub_container'
	var searchsubInputContainer = document.querySelector('#js-header_search_input_sub_container');

	// ------------------------------------
	// No nav? Exit.
	// ------------------------------------
	if ( searchInputContainer === null && searchsubInputContainer === null ) {
		return;
	}

	// ------------------------------------
	// escapeMarkup based on: https://github.com/select2/select2/blob/6645ffd4bddcc178c8c1c8588c6b2a93290a4cca/src/js/select2/utils.js
	// ------------------------------------
	function escapeMarkup(markup) {

		var replaceMap = {
				'\\': '&#92;',
				'&': '&amp;',
				'<': '&lt;',
				'>': '&gt;',
				'"': '&quot;',
				'\'': '&#39;',
				'/': '&#47;'
		};

		return String(markup).replace(/[&<>"'\/\\]/g, function (match) {
			return replaceMap[match];
		});

	}

	// ---------------------------------
	// Lazy-load terms
	// ---------------------------------
	var lazyTerms = [];
	
	function getTerms(callback) {

		var endpoint;

		// Non-root install?
		if ( typeof fbcorp_typeahead === 'object' && typeof fbcorp_typeahead.sitedir === 'string' && fbcorp_typeahead.sitedir.length > 0 ) {

			var sitedirRegExp = /^\/[a-z0-9]+\/$/i;
		
			// Valid subdirectory? (e.g. /whatever/)
			if ( sitedirRegExp.test(fbcorp_typeahead.sitedir) ) {
				endpoint = fbcorp_typeahead.sitedir + 'fbcorp/v1/suggest/';
			} else {
				console.error('typeahead error code 0.', fbcorp_typeahead);
				return false;
			}
		
		// Root install?
		} else {
		
			endpoint = '/fbcorp/v1/suggest/';
		
		}

		$.ajax({
			url: endpoint,
			type: 'GET',
			cache: true,
			success: function(response) {
				if ( typeof response === 'object' && typeof response.success === 'boolean' && response.success && typeof response.data === 'object' && $.isArray(response.data) ) {
					callback(response.data);
				} else if ( typeof response.data !== 'undefined' ) {
					if ( $('body').hasClass('logged-in') ) {
						// (Probably intentionally disabled)
						console.warn('Typeahead:', response.data);
					}
				} else {
					console.error('typeahead error code 2.');
				}
			},
			error: function(errorThrown){
				var errorThrown = ( typeof errorThrown !== 'undefined' ) ? errorThrown : 'Unknown';
				console.error('typeahead error code 3:', errorThrown);
			}
		});

	}

	// Lazy load terms on search toggle click
	$(searchToggleSel).on('click.typeahead', function(){
		$(this).off('click.typeahead');
		$(window).trigger('searchfocus');
	});

	$(searchsubToggleSel).on('click.typeahead', function(){
		$(this).off('click.typeahead');
		$(window).trigger('searchfocus');
	});

	$(window).on('searchfocus', function(){
		getTerms(function(terms){
			lazyTerms = terms;
		});
	});

	// ---------------------------------
	// Filter matches
	// ---------------------------------
	function suggest(query, populateResults) {

		var filteredResults = [];
		var resultsFound = 0;
		var termCount = lazyTerms.length;

		// If terms have loaded & any exist
		if ( termCount && typeof query === 'string' && query.length ) {
			query = query.toLowerCase();
			for (i = 0; i < termCount; i++) {
				if ( lazyTerms[i].indexOf(query) !== -1 ) {
					filteredResults.push(lazyTerms[i]);
					resultsFound++;
					if ( resultsFound === maxResults ) {
						break;
					}
				}
			}
		}

		populateResults(filteredResults);

	}

	// ---------------------------------
	// Submit form
	// ---------------------------------
	function submitSearch($form) {
		if ($form.length) {
			$form.addClass('submitted');
			$form.submit();
		}
	}

	// Create a function to generate consistent autocomplete options
	function createAutocompleteOptions(fieldId, container) {
		return {
			onConfirm: function(val){
				setTimeout(function(){
					submitSearch($('#' + fieldId).closest('form'));
				}, 0);
			},
			confirmOnBlur: false,
			minLength: 1,
			showNoOptionsFound: false,
			name: 's',
			templates: {
				suggestion: function(text) {
					return escapeMarkup(text);
				}
			},
			source: suggest,
			element: container,
			id: fieldId,
			cssNamespace: 'autocomplete'
		};
	}

	// Initialize main search
	if (searchInputContainer !== null) {
		//console.log('Initializing main search');
		accessibleAutocomplete(createAutocompleteOptions(searchFieldID, searchInputContainer));
	}

	// Initialize sub search - ensure this runs even if main search isn't present
	if (searchsubInputContainer !== null) {
		//console.log('Initializing sub search');
		accessibleAutocomplete(createAutocompleteOptions(searchsubFieldID, searchsubInputContainer));
	}

	// Trigger loaded event only after both are initialized
	setTimeout(function() {
		$(window).trigger('typeaheadloaded');
	}, 100);

