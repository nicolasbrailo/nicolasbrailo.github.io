		// =================================
		// Ancestor Attributes (for analytics)
		// =================================
		function setupAncestorAttributes($navigation) {
			if (!$navigation || $navigation.length < 1) return;
			
			var linkSel = 'a.menu-link, button.menu-link';

			$navigation.find('li.menu-item').each(function(i){
					var $li = $(this);
					var $thisLink = $li.children(linkSel);

					var depth0Text = $li.closest('li.menu-item-depth-0').not($li).children(linkSel).text();
					if ( depth0Text ) {
							$thisLink.attr('data-depth0', depth0Text);
					} else {
							return;
					}

					var depth1Text = $li.closest('li.menu-item-depth-1').not($li).children(linkSel).text();
					if ( depth1Text ) {
							$thisLink.attr('data-depth1', depth1Text);
					} else {
							return;
					}

					var depth2Text = $li.closest('li.menu-item-depth-2').not($li).children(linkSel).text();
					if ( depth2Text ) {
							$thisLink.attr('data-depth2', depth2Text);
					} else {
							return;
					}
			});
		}

		setupAncestorAttributes($nav);
		setupAncestorAttributes($navsub);

		function resetMegaMenuState($toggle) {
			var $megaDiv = $('.mega.mega-depth-0.top-mega.open');
			var $fadeInDiv = $('.twocolumn-mm.fadeIn');

			if ($megaDiv.css('display') === 'none' && $fadeInDiv.length) {
					$('body').removeClass('mega-open-transition');
					$toggle.parent().removeClass('active');
					$fadeInDiv.removeClass('fadeIn').addClass('fadeOut');
					$toggle.children('.dd-arrow-img').removeClass('rotatearrow');
					$megaDiv.removeClass('open');
			}
		}

		// Add event listener for mouseleave on relevant elements
		$(document).on('mouseleave', '.mega-toggle, .twocolumn-mm', function(e) {
				var $thisToggle = $(this).hasClass('mega-toggle') ? $(this) : $(this).prev('.mega-toggle');
				resetMegaMenuState($thisToggle);
		});

		// Add additional mouseleave listener on the body to handle edge cases
		$(document).on('mouseleave', 'body', function() {
				var $activeToggle = $('.mega-toggle.active');
				if ($activeToggle.length) {
						resetMegaMenuState($activeToggle);
				}
		});

		function resetOtherNavStates(currentNavId) {
			const navIds = ['#site-navigation', '#site-subnavigation'];
			navIds.forEach(navId => {
					if (navId !== currentNavId) {
							const $nav = $(navId);
							const $openMenuLink = $nav.find('.menu-link.mega-toggle.a_main_menu_link[aria-expanded="true"]');
							if ($openMenuLink.length) {
									// Use the kMega instance to properly close the menu
									const mega = $openMenuLink.data('kMega');
									if (typeof mega !== 'undefined') {
											mega.leave();
									}
							}
					}
			});
		}

		// Enhanced mouseenter event that only resets other navs when a menu is actually opening
		$(document).on('mouseenter', '.menu-link.mega-toggle.a_main_menu_link', function() {
				const $this = $(this);
				const $currentNav = $this.closest('nav');
				const currentNavId = `#${$currentNav.attr('id')}`;
				
				// Only reset other navs if this menu is not already open and will actually open
				if ($this.attr('aria-expanded') !== 'true') {
						// Add a small delay to allow the kMega hover logic to process first
						setTimeout(function() {
								if ($this.attr('aria-expanded') === 'true') {
										resetOtherNavStates(currentNavId);
								}
						}, 50);
				}
		});

		// Mouseleave event to ensure the nav doesn't stay open when leaving the area
		$(document).on('mouseleave', 'nav', function() {
				const $nav = $(this);
				const $openMenuLink = $nav.find('.menu-link.mega-toggle.a_main_menu_link[aria-expanded="true"]');
				if ($openMenuLink.length) {
						// Use the kMega instance to properly close the menu
						const mega = $openMenuLink.data('kMega');
						if (typeof mega !== 'undefined') {
								mega.leave();
						}
				}
		});

