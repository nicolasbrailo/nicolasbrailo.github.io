			$stylesheet.append(document.createTextNode('.alert-wrapper--site { display: none !important; }'));
		}

		if ( pageAlertClosed ) {
			$stylesheet.append(document.createTextNode('.alert-wrapper--page { display: none !important; }'));
		// Priority 2: Site-level alert
		} else if ( hasSiteAlert && ! siteAlertClosed ) {
