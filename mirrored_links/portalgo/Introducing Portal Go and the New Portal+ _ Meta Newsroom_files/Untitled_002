						// Remove from DOM so we don't reveal it again
						$thisAlert.remove();
					}
				})
				;
				
				openAlert( $nextAlert );
		
		});

		if ( hasLocalePrompt && ! localePromptClosed ) {
			
			// Get first match of two-digit locale (e.g. es) – NOTE: this does not account for multiple version of the same language (e.g. es-ES and es-LTAM)
			var $localeSelect = $('select.language-select-b-' + userLang).first();
		
			if ( $localeSelect.length ) {
			
				// ---------------------------------
				// Instantiate Select2
				// ---------------------------------
				// Redirect on locale prompt select
				$localeSelect.on('change', function() {
					var language_choice_b = $(this).val();
					window.location = language_choice_b;
				});
				
				$localeSelect.select2({
					theme: "locale-prompt"
				});
				
				// ---------------------------------
				// Click to close locale prompt
				// ---------------------------------
				$('#js_locale_prompt_close').click(function(e){
	
					e.preventDefault();
					var $button = $(this);
					
					// Save this action to visitor's cookies
					dontShowAgain($button.attr('data-id'));
					
					var $firstAlert = $(alertSel).first();
					
					$('#js_locale_prompt')
						// Announce closed state a bit early to screen readers, to ensure this gets announced (before its container becomes hidden & thus invisible to screen readers)
						.attr('aria-expanded', 'false')
						// Close locale prompt
						.slideUp({
							// Animate simultaneous to alert opening
							queue: false,
							duration: 400
						});
						
					openAlert( $firstAlert );
						
				});
				
			}
		
		}
		
	});

