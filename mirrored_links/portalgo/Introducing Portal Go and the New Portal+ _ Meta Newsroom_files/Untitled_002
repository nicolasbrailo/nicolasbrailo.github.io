	function getUserLang() {

		// "In Chrome, navigator.language is the language of the browser UI, and is not guaranteed to be equal to navigator.languages[0]"
		var lang = navigator.language || navigator.userLanguage;

		if ( typeof lang === 'string' && lang ) {

			// Change "en-US" to "en" (unless it's a language with multiple versions)
			var abbrevLang = lang.slice(0, 2);
			
			// Special rules for languages with multiple versions
			if ( abbrevLang === 'es' ) {
				
				lang = lang.replace('-', '_');
				
				if ( lang === 'es' || lang === 'es_ES' ) {
				
					lang = 'es_ES';
				
				// Default to LTAM
				} else {
				
					lang = 'es_419';
				
				}
				
			} else {
				
				// Use two-digit code (en, fr, etc.)
				lang = abbrevLang;
			
			}
			
		} else {
			
			lang = 'en';
			
		}
		
		// Unsupported language?
		if ( localeWhitelist.indexOf(abbrevLang) < 0 ) {
			// Default to English
			lang = 'en';
			
		}
		
		if ( debugMode ) {
			console.log('getUserLang:', lang);
		}
	
		return lang;
	
	}

