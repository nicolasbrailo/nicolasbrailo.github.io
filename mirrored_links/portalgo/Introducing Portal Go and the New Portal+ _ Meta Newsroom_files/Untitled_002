		if ( typeof fbcorp_alert_bar.page_alert_id !== 'undefined' && fbcorp_alert_bar.page_alert_id ) {
			hasPageAlert = true;
			if ( closedAlertsArr && closedAlertsArr.indexOf(fbcorp_alert_bar.page_alert_id) >= 0 ) {
				if ( debugMode ) {
					console.log('Alert was dismissed:', fbcorp_alert_bar.page_alert_id);
				}
