		var closedAlertsArr = fbcorpCookies.getJSON('fbcorp_closed_alerts');
		
		if ( typeof closedAlertsArr === 'undefined' || ! $.isArray(closedAlertsArr) ) {
			closedAlertsArr = false;
		}

		if ( debugMode ) {
			console.log('rememberClosedAlerts - closedAlertsArr', closedAlertsArr);
		}

